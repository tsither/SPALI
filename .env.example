# Copy this file to .env and fill in your keys:
#   cp .env.example .env

# Anthropic API key — used for natural-language extraction (Claude)
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Voyage AI API key — used for embeddings (course/module vector search)
# https://dashboard.voyageai.com/
VOYAGE_API_KEY=
